{
  "permissions": {
    "allow": [
      "Bash(just debug)",
      "Bash(just rebuild)",
      "Bash(just release)",
      "Bash(bash tools/build.sh:*)",
      "Bash(bash tools/cloud-setup.sh:*)",
      "Bash(python3 tools/references.py:*)",
      "Bash(clang-format -i:*)"
    ],
    "deny": [
      "Edit(.reference-data/**)",
      "Edit(extracts/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-cpp.sh"
          }
        ]
      }
    ]
  }
}
