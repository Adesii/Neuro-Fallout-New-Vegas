{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-i686-msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-i686-msvc.cmake",
      "binaryDir": "${sourceDir}/build/cloud/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "NEURO_FNV_MSVC_ROOT": "$env{NEURO_FNV_MSVC_ROOT}"
      }
    },
    {
      "name": "windows-i686-msvc-debug",
      "inherits": "windows-i686-msvc-base",
      "displayName": "Windows i686 MSVC Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-i686-msvc-release",
      "inherits": "windows-i686-msvc-base",
      "displayName": "Windows i686 MSVC Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-i686-msvc-debug",
      "configurePreset": "windows-i686-msvc-debug"
    },
    {
      "name": "windows-i686-msvc-release",
      "configurePreset": "windows-i686-msvc-release"
    }
  ]
}
